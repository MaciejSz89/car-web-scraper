{
  "profile_name": "default",
  "global": {
    "hard_filters": {
      "max_price_pln": 55000,
      "max_mileage_km": 170000,
      "min_year": 2016,
      "fuel_types": ["Benzyna"],
      "min_engine_cm3": 1250,
      "min_power_hp": 100,
      "gearboxes": ["Manualna", "Automatyczna"]
