{
  "profile_name": "default",
  "llm": {
    "max_notification_llm_calls": 10
  },
  "enrichment": {
    "allowed_buckets": ["candidate", "high-priority"]
  },
  "global": {
    "hard_filters": {
      "max_price_pln": 55000,
      "max_mileage_km": 170000,
      "min_year": 2016,
      "fuel_types": ["Benzyna"],
      "min_engine_cm3": 1250,
      "min_power_hp": 100,
      "gearboxes": ["Manualna", "Automatyczna"]
    },
    "soft_preferences": {
      "preferred_gearboxes": {
        "Automatyczna": 12,
        "Manualna": 0
      },
      "preferred_fuel_types": {
        "Benzyna": 10,
        "Hybryda": 4,
        "LPG": -8
      },
      "year_boost": {
        "min_year": 2020,
        "score": 8
      },
      "low_mileage_boost": {
        "max_mileage_km": 90000,
        "score": 10
      },
      "high_mileage_penalty": {
        "min_mileage_km": 140000,
        "score": -12
      }
    },
    "notification_filters": {
      "min_final_score": 75,
      "min_confidence_score": 80,
      "require_hard_filter_pass": true,
      "allowed_buckets": ["high-priority"],
      "allow_reactivated": false,
      "min_reactivated_absence_days": 3,
      "bucket_upgrade_target_buckets": ["high-priority"],
      "suppress_bucket_upgrade_after_reactivation_hours": 72,
      "exclude_damaged_listings": true,
      "damaged_handling": "llm",
      "blocked_enrichment_flags": [
        "airbags_deployed",
        "severe_front_damage",
        "severe_rear_damage",
        "total_loss_declared",
        "scrap_candidate",
        "parts_only_vehicle"
      ]
    },
    "notification_channels": [
      "log",
      {
        "type": "telegram",
        "bot_token_env": "OTOMOTO_TELEGRAM_BOT_TOKEN",
        "chat_id_env": "OTOMOTO_TELEGRAM_CHAT_ID",
        "disable_web_page_preview": true
      },
      {
        "type": "telegram",
        "bot_token_env": "OTOMOTO_TELEGRAM_BOT_TOKEN",
        "chat_id_env": "OTOMOTO_TELEGRAM_CHAT_ID_2",
        "disable_web_page_preview": true
      }
    ]
  },
  "queries": {
    "Honda Jazz": {
      "notification_filters": {
        "min_confidence_score": 60
      }
    },
    "Volkswagen Golf Sportsvan": {
      "notification_filters": {
        "min_confidence_score": 70
      }
    }
  }
}
