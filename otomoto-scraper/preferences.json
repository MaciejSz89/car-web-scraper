        "Automatyczna": 12,
        "Manualna": 0
      },
      "preferred_fuel_types": {
        "Benzyna": 10,
        "Hybryda": 4,
        "LPG": -8
      },
      "year_boost": {
        "min_year": 2020,
        "score": 8
      },
      "low_mileage_boost": {
        "max_mileage_km": 90000,
        "score": 10
      },
      "high_mileage_penalty": {
