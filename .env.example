# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore — nigdy go nie commituj.

# --- Sekrety (nazwy zmiennych wskazuje preferences.json: *_env) ---
OPENAI_API_KEY=
OTOMOTO_TELEGRAM_BOT_TOKEN=
OTOMOTO_TELEGRAM_CHAT_ID=
OTOMOTO_TELEGRAM_CHAT_ID_2=

# --- Ustawienia aplikacji (opcjonalne) ---
# CARSCRAPER_HEADLESS=1
# CARSCRAPER_DATA_DIR=/data
# CARSCRAPER_CONFIG_DIR=/config

# --- Ustawienia docker compose (opcjonalne) ---
# CARSCRAPER_VERSION=0.2.0
# CARSCRAPER_LOOP_INTERVAL=1800
# CARSCRAPER_HOST_DATA_DIR=./data/otomoto
# CARSCRAPER_HOST_CONFIG_DIR=./otomoto-scraper
